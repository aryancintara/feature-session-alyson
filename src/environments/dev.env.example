# Copy this file in this folder to one of:
# - .local.env for `bun run dev` or `bun run dev local`
# - .mock.env for optional mock-specific overrides used by `bun run dev mock`
# - .staging.env for `bun run dev staging`
# - .prod.env for `bun run dev prod`
#
# Existing .dev.env files still work as a fallback for local/staging/mock.

# Normal development uses a real backend. Mock mode does not require backend or
# Cognito values and reviews the AI Page Builder with local fixtures.
# `bun --bun run dev mock` overrides LOCAL_MODE to mock and ENABLE_DEV_LOGIN
# to true, including when this file is reused from a real-backend setup.
REACT_APP_LOCAL_MODE=remote
REACT_APP_ENABLE_DEV_LOGIN=false

REACT_APP_COGNITO_REGION=
REACT_APP_COGNITO_USER_POOL_ID=
REACT_APP_COGNITO_CLIENT_ID=
REACT_APP_COGNITO_DOMAIN=

# The canonical staging host is api-stage.palisade.ai (not api-staging.palisade.ai).
REACT_APP_API_BASE_URL=https://api-stage.palisade.ai
# `bun run dev mock` forces this to true at runtime. Mock mode is disabled in
# production builds, creates an in-memory dev login, and never needs credentials.
REACT_APP_AI_PAGE_BUILDER_USE_MOCKS=false
REACT_APP_ALYSON_NOTETAKER_BASE_URL=https://api-uic1.onrender.com
# Alyson Pulse API (NestJS on API Gateway). Separate from REACT_APP_API_BASE_URL.
# Prod: https://backend-api-URL
# Local Nest: http://localhost:3000
REACT_APP_ALYSON_PULSE_API_BASE_URL=https://rxbi86aui3.execute-api.us-west-2.amazonaws.com
REACT_APP_APP_ORIGIN=http://localhost:3000/
REACT_APP_CLOUDFRONT_URL=

# Analytics is opt-in. Deployed environments may enable it with their own IDs.
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_SEGMENT_WRITE_KEY=
REACT_APP_FULLSTORY_ORG_ID=

ENV=dev
GENERATE_SOURCEMAP=false

REACT_APP_GOOGLE_CLIENT_ID=

# Session Explorer (Data → Sessions). Server-only key — used by /__session_api
# in local Vite; never prefix with REACT_APP_ (must not reach the browser).
# API: https://6s2ai70d6l.execute-api.us-west-2.amazonaws.com/prod
SESSION_API_KEY=
# Optional override of the Session API base URL.
# REACT_APP_SESSION_API_BASE_URL=https://6s2ai70d6l.execute-api.us-west-2.amazonaws.com/prod

