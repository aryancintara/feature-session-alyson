import { createFileRoute, useSearch } from "@tanstack/react-router";
import { useEffect, useState } from "react";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { toast } from "sonner";
import { PageHeader } from "@/components/ui-bits";
import { MetricCard, Panel, DataTable, Td, Pill } from "@/components/identity/bits";
import { EmptyState } from "@/components/identity/ProcessDateSelect";
import { MetricRowSkeleton, TableSkeleton, ErrorState } from "@/components/identity/skeletons";
import {
  remediationListQuery,
  createRemediation,
  errorsQuery,
  REMEDIATION_ACTIONS,
  REMEDIATION_STATUSES,
  type RemediationPayload,
} from "@/lib/identityApi";

type RemediationSearch = { errorType?: string; example?: string };

export const Route = createFileRoute("/identity/remediation")({
  validateSearch: (search: Record<string, unknown>): RemediationSearch => ({
    errorType: typeof search["errorType"] === "string" ? search["errorType"] : undefined,
    example: typeof search["example"] === "string" ? search["example"] : undefined,
  }),
  component: RemediationPage,
});

const inputCls =
  "w-full rounded-md border border-border bg-background px-2.5 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-ring";

function RemediationPage() {
  const search = useSearch({ from: "/identity/remediation" });
  const queryClient = useQueryClient();

  const list = useQuery(remediationListQuery(50));
  const errorCatalog = useQuery(errorsQuery(undefined, "all"));
  const entries = list.data?.remediations ?? [];

  const [open, setOpen] = useState(false);
  const [errorType, setErrorType] = useState(search.errorType ?? "");
  const [example, setExample] = useState(search.example ?? "");
  const [action, setAction] = useState<string>("flag");
  const [status, setStatus] = useState<string>("open");
  const [revcloudPersonId, setRevcloudPersonId] = useState("");
  const [relatedPersonId, setRelatedPersonId] = useState("");
  const [entityType, setEntityType] = useState("");
  const [entityRecordId, setEntityRecordId] = useState("");
  const [sessionId, setSessionId] = useState("");
  const [reason, setReason] = useState("");
  const [actor, setActor] = useState("ui-operator");

  useEffect(() => {
    if (search.errorType) {
      setErrorType(search.errorType);
      setExample(search.example ?? "");
      setOpen(true);
    }
  }, [search.errorType, search.example]);

  const mutation = useMutation({
    mutationFn: (payload: RemediationPayload) => createRemediation(payload),
    onSuccess: (res) => {
      toast.success(`Remediation ${res.remediationId.slice(0, 8)} recorded`);
      setOpen(false);
      setReason("");
      queryClient.invalidateQueries({ queryKey: ["identity", "remediation"] });
    },
    onError: (e: Error) => toast.error(e.message),
  });

  const submit = () => {
    if (!reason.trim()) {
      toast.error("Reason is required");
      return;
    }
    mutation.mutate({
      action,
      status,
      errorType: errorType || undefined,
      example: example || undefined,
      revcloudPersonId: revcloudPersonId || undefined,
      relatedPersonId: relatedPersonId || undefined,
      entityType: entityType || undefined,
      entityRecordId: entityRecordId || undefined,
      sessionId: sessionId || undefined,
      reason,
      actor,
    });
  };

  const count = (s: string) => entries.filter((e) => e.status === s).length;

  return (
    <div className="pb-10">
      <PageHeader
        title="Remediation"
        subtitle="Operator actions on graph errors — live GET/POST /v1/remediation."
        actions={
          <button
            onClick={() => setOpen((v) => !v)}
            className="rounded-md border border-primary bg-primary/10 px-3 py-1.5 text-xs font-medium hover:bg-primary/20"
          >
            {open ? "Close form" : "Create remediation"}
          </button>
        }
      />

      {list.isPending ? (
        <MetricRowSkeleton count={4} />
      ) : list.error ? (
        <div className="px-6">
          <div className="rounded-xl border border-border bg-card">
            <ErrorState message={(list.error as Error).message} onRetry={() => list.refetch()} />
          </div>
        </div>
      ) : (
        <div className="grid grid-cols-2 gap-3 px-6 lg:grid-cols-4">
          <MetricCard label="Log entries" value={String(entries.length)} />
          <MetricCard label="Open" value={String(count("open"))} tone="destructive" />
          <MetricCard label="Investigating" value={String(count("investigating"))} tone="warning" />
          <MetricCard label="Resolved" value={String(count("resolved"))} tone="success" />
        </div>
      )}

      {open ? (
        <div className="px-6 pt-4">
          <Panel title="Create remediation" description="POST /v1/remediation">
            <div className="grid grid-cols-1 gap-3 p-4 md:grid-cols-3">
              <Labeled label="Error type">
                <select value={errorType} onChange={(e) => setErrorType(e.target.value)} className={inputCls}>
                  <option value="">— none —</option>
                  {(errorCatalog.data?.errors ?? []).map((e) => (
                    <option key={e.errorType} value={e.errorType}>
                      {e.errorType}
                    </option>
                  ))}
                  {errorType && !(errorCatalog.data?.errors ?? []).some((e) => e.errorType === errorType) ? (
                    <option value={errorType}>{errorType}</option>
                  ) : null}
                </select>
              </Labeled>
              <Labeled label="Action">
                <select value={action} onChange={(e) => setAction(e.target.value)} className={inputCls}>
                  {REMEDIATION_ACTIONS.map((a) => (
                    <option key={a} value={a}>
                      {a}
                    </option>
                  ))}
                </select>
              </Labeled>
              <Labeled label="Status">
                <select value={status} onChange={(e) => setStatus(e.target.value)} className={inputCls}>
                  {REMEDIATION_STATUSES.map((s) => (
                    <option key={s} value={s}>
                      {s}
                    </option>
                  ))}
                </select>
              </Labeled>
              <Labeled label="Example">
                <input value={example} onChange={(e) => setExample(e.target.value)} className={inputCls} placeholder="8328168998 — 37 people" />
              </Labeled>
              <Labeled label="RevCloud person ID">
                <input value={revcloudPersonId} onChange={(e) => setRevcloudPersonId(e.target.value)} className={inputCls} placeholder="rev_user_296352421" />
              </Labeled>
              <Labeled label="Related person ID">
                <input value={relatedPersonId} onChange={(e) => setRelatedPersonId(e.target.value)} className={inputCls} placeholder="rev_user_290114872" />
              </Labeled>
              <Labeled label="Entity type">
                <input value={entityType} onChange={(e) => setEntityType(e.target.value)} className={inputCls} placeholder="Segment Events" />
              </Labeled>
              <Labeled label="Entity record ID">
                <input value={entityRecordId} onChange={(e) => setEntityRecordId(e.target.value)} className={inputCls} />
              </Labeled>
              <Labeled label="Session ID">
                <input value={sessionId} onChange={(e) => setSessionId(e.target.value)} className={inputCls} />
              </Labeled>
              <Labeled label="Actor">
                <input value={actor} onChange={(e) => setActor(e.target.value)} className={inputCls} />
              </Labeled>
              <div className="md:col-span-2">
                <Labeled label="Reason">
                  <textarea value={reason} onChange={(e) => setReason(e.target.value)} rows={2} className={inputCls} placeholder="Why this action is being taken" />
                </Labeled>
              </div>
            </div>
            <div className="flex justify-end gap-2 border-t border-border px-4 py-3">
              <button onClick={() => setOpen(false)} className="rounded-md border border-border px-3 py-1.5 text-xs font-medium hover:bg-accent">
                Cancel
              </button>
              <button
                onClick={submit}
                disabled={mutation.isPending}
                className="rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-primary-foreground hover:opacity-90 disabled:opacity-50"
              >
                {mutation.isPending ? "Submitting…" : "Submit remediation"}
              </button>
            </div>
          </Panel>
        </div>
      ) : null}

      <div className="px-6 pt-4">
        <Panel title="Remediation log" description="GET /v1/remediation · newest first">
          <DataTable
            head={["ID", "Created", "Action", "Status", "Error type", "Example", "Person", "Reason", "Actor"]}
            align={["left", "left", "left", "left", "left", "left", "left", "left", "left"]}
          >
            {list.isPending ? (
              <TableSkeleton cols={9} rows={6} />
            ) : (
              entries.map((e) => (
                <tr key={e.remediationId} className="hover:bg-accent/40">
                  <Td mono>{e.remediationId.slice(0, 8)}</Td>
                  <Td mono className="text-muted-foreground">{e.createdAt}</Td>
                  <Td>
                    <Pill tone="info">{e.action}</Pill>
                  </Td>
                  <Td>
                    <Pill tone={e.status === "open" ? "danger" : e.status === "investigating" ? "warning" : e.status === "resolved" ? "success" : "neutral"}>
                      {e.status}
                    </Pill>
                  </Td>
                  <Td className="font-medium">{e.errorType ?? "—"}</Td>
                  <Td className="text-muted-foreground">{e.example ?? "—"}</Td>
                  <Td mono className="text-muted-foreground">{e.revcloudPersonId ?? "—"}</Td>
                  <Td className="text-muted-foreground">{e.reason ?? "—"}</Td>
                  <Td className="text-muted-foreground">{e.actor ?? "—"}</Td>
                </tr>
              ))
            )}
          </DataTable>
          {!list.isPending && entries.length === 0 ? <EmptyState label="No remediation entries yet" /> : null}
        </Panel>
      </div>
    </div>
  );
}

function Labeled({ label, children }: { label: string; children: React.ReactNode }) {
  return (
    <div>
      <div className="mb-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">{label}</div>
      {children}
    </div>
  );
}
