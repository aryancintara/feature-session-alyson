{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-west-2:221490242148:log-group:/aws/lambda/cost-revenue-api:*"
    },
    {
      "Sid": "Athena",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup"
      ],
      "Resource": "arn:aws:athena:us-west-2:221490242148:workgroup/ipintel_etl"
    },
    {
      "Sid": "GlueReadRules",
      "Effect": "Allow",
      "Action": ["glue:GetDatabase", "glue:GetTable", "glue:GetPartitions"],
      "Resource": [
        "arn:aws:glue:us-west-2:221490242148:catalog",
        "arn:aws:glue:us-west-2:221490242148:database/cost_revenue",
        "arn:aws:glue:us-west-2:221490242148:table/cost_revenue/rules",
        "arn:aws:glue:us-west-2:221490242148:table/cost_revenue/revenue_events",
        "arn:aws:glue:us-west-2:221490242148:table/cost_revenue/cost_events",
        "arn:aws:glue:us-west-2:221490242148:database/sampledb",
        "arn:aws:glue:us-west-2:221490242148:table/sampledb/revenue_leads_plus",
        "arn:aws:glue:us-west-2:221490242148:database/raw",
        "arn:aws:glue:us-west-2:221490242148:table/raw/raw_tune_clicks"
      ]
    },
    {
      "Sid": "GlueUpdateRules",
      "Effect": "Allow",
      "Action": "glue:UpdateTable",
      "Resource": [
        "arn:aws:glue:us-west-2:221490242148:catalog",
        "arn:aws:glue:us-west-2:221490242148:database/cost_revenue",
        "arn:aws:glue:us-west-2:221490242148:table/cost_revenue/rules"
      ]
    },
    {
      "Sid": "ReadPreviewSources",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::datalake-unified-221490242148-us-west-2/cost_revenue/revenue_events/*",
        "arn:aws:s3:::datalake-unified-221490242148-us-west-2/cost_revenue/cost_events/*",
        "arn:aws:s3:::datalake-raw-221490242148-us-west-2/tune/raw_tune_clicks_3/*",
        "arn:aws:s3:::datalake-landingzone-221490242148-us-west-2/iceberg/sampledb.db/revenue_leads_plus/*"
      ]
    },
    {
      "Sid": "ListPreviewSources",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::datalake-unified-221490242148-us-west-2",
        "arn:aws:s3:::datalake-raw-221490242148-us-west-2",
        "arn:aws:s3:::datalake-landingzone-221490242148-us-west-2"
      ]
    },
    {
      "Sid": "ReadWriteRuleFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::datalake-unified-221490242148-us-west-2/cost_revenue/rules/*"
    },
    {
      "Sid": "ListRulePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::datalake-unified-221490242148-us-west-2",
      "Condition": {
        "StringLike": { "s3:prefix": ["cost_revenue/rules", "cost_revenue/rules/*"] }
      }
    },
    {
      "Sid": "QueryResults",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::aws-athena-query-results-221490242148-us-west-2/cost-revenue-api/*"
    },
    {
      "Sid": "ListQueryResults",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aws-athena-query-results-221490242148-us-west-2",
      "Condition": {
        "StringLike": { "s3:prefix": ["cost-revenue-api", "cost-revenue-api/*"] }
      }
    },
    {
      "Sid": "BucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": [
        "arn:aws:s3:::datalake-unified-221490242148-us-west-2",
        "arn:aws:s3:::datalake-raw-221490242148-us-west-2",
        "arn:aws:s3:::datalake-landingzone-221490242148-us-west-2",
        "arn:aws:s3:::aws-athena-query-results-221490242148-us-west-2"
      ]
    }
  ]
}
