# Same Cognito pool and web app client as Alyson for this environment.
COGNITO_USER_POOL_ID=us-west-2_XXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Or: COGNITO_CLIENT_IDS=id1,id2
AWS_REGION=us-west-2

# Optional. Comma-separated workspace ids this API accepts.
# ALLOWED_WORKSPACES=253

# Local fake Cognito only. Never set in deployed environments.
# LOCAL_DEV_MODE=local
# COGNITO_JWKS_FILE=/absolute/path/to/jwks.json
